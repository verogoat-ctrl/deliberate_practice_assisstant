{
  "name": "deliberate-practice-assistant",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "concurrently \"npm run dev:server\" \"npm run dev:client\"",
    "dev:client": "node client/node_modules/vite/bin/vite.js --config client/vite.config.js client",
    "dev:server": "node server/index.js",
    "build": "node client/node_modules/vite/bin/vite.js build --config client/vite.config.js client"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.39.0",
    "concurrently": "^9.1.2",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^5.1.0"
  }
}
